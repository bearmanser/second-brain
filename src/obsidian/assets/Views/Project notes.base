filters:
  and:
    - 'file.ext == "md"'
    - 'note.project == this.file.asLink()'
    - 'file.path != this.file.path'
    - '!file.inFolder("Templates")'
views:
  - type: table
    name: Project notes
    order:
      - file.name
      - note.type
      - note.status
      - note.updated
      - note.tags
