# Deployment inputs consumed by Docker Compose and scripts/setup.sh.
#
# scripts/setup.sh populates this file with the digest-pinned image references
# from config/images.env and the configured vault path. The committed file keeps
# only placeholders so a clean checkout can run `docker compose config` after
# setup without interpolating missing variables.
NODE_IMAGE=node@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
PYTHON_IMAGE=python@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
VAULT_PATH=./vault
BRAIN_PORT=7331
# Single bearer-token digest for the whole brain. The value is the lowercase
# SHA-256 hex digest of a high-entropy token; the raw token is presented by the
# MCP client as `Authorization: Bearer <token>`. There is intentionally no
# example value here, because a committed default would be an insecure default.
# Generate a token and its digest with:
#   node dist/cli.js auth generate --show-token
# Rotate by replacing only this value and restarting the gateway; sending SIGHUP
# cannot reload an environment value already injected by Compose. The old token
# stops authenticating on the next request. The digest is never logged or copied
# into the vault.
# BRAIN_TOKEN_SHA256=
# Runtime UID/GID for the container and for setup-created files and volumes.
# Override these together when the host user or vault owner is not 1000.
BRAIN_UID=1000
BRAIN_GID=1000
# Retrieval defaults. `text` never depends on the local model. Enable reranking
# only after the evaluated release gate by setting BRAIN_SEARCH_MODE=reranked and
# BRAIN_LAYA_ENABLED=true together; an inconsistent pair is rejected at startup.
BRAIN_SEARCH_MODE=text
BRAIN_LAYA_ENABLED=false
BRAIN_LAYA_MODEL_DIR=/var/lib/second-brain/models/laya/runtime
BRAIN_LAYA_BATCH_SIZE=8
BRAIN_LAYA_QUEUE_BATCHES=4
BRAIN_LAYA_TIMEOUT_MS=4000
BRAIN_LAYA_THREADS=2
BRAIN_RECONCILE_INTERVAL_MS=30000
# Runtime bounds enforced by Compose rather than ignored deployment metadata.
BRAIN_MEMORY_LIMIT=6g
BRAIN_CPU_LIMIT=2.0
